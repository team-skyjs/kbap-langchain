# 이 파일을 .env 로 복사해 값을 채운다. .env 는 gitignore 되어 있다.
#   cp .env.example .env

# kbap 어드민 API 인증 토큰 (필수)
KBAP_API_TOKEN=

# 채점 모델 API 키 (필수) — config.yaml 의 llm.model 이 openai:* 일 때 (현재 기본값)
OPENAI_API_KEY=
# config.yaml 에서 gemini-2.5-flash 로 되돌렸다면 이쪽을 쓴다
# GOOGLE_API_KEY=

# Langfuse 트레이싱 (선택) — LANGFUSE_PUBLIC_KEY 가 없으면 트레이싱 자체를 끈다
# 키는 cloud.langfuse.com > Settings > API Keys 에서 발급. HOST 는 키 발급 화면에 표시된
# 리전 주소를 그대로 쓴다 (EU: https://cloud.langfuse.com, US: https://us.cloud.langfuse.com)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# 트레이스 환경 구분 (development|staging|production) — 대시보드에서 로컬 실행을 분리한다
# LANGFUSE_TRACING_ENVIRONMENT=development
