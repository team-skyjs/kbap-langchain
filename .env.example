# 이 파일을 .env 로 복사해 값을 채운다. .env 는 gitignore 되어 있다.
#   cp .env.example .env

# kbap 어드민 API 인증 토큰 (필수)
KBAP_API_TOKEN=

# 채점 모델 API 키 (필수) — config.yaml 의 llm.model 이 gemini* 일 때
GOOGLE_API_KEY=
# config.yaml 에서 "openai:gpt-5-mini" 처럼 다른 벤더로 바꿨다면 그쪽 키를 쓴다
# OPENAI_API_KEY=

# Langfuse 트레이싱 (선택) — LANGFUSE_PUBLIC_KEY 가 없으면 트레이싱 자체를 끈다
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
